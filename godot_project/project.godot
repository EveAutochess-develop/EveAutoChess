; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EVE Autochess"
config/description="Godot remake - thin shell + hotupdate content"
config/version="1.0.0-shell"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AdminBus="*res://scripts/admin/admin_bus.gd"
DataStore="*res://scripts/core/data_store.gd"
GameSession="*res://scripts/core/game_session.gd"
MCPRuntime="*res://addons/godot_mcp/runtime/mcp_runtime.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=2
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=3
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.12, 1)
anti_aliasing/quality/screen_space_aa=1
##Desktopclarity:3Dsupersample+MSAA8+FXAA.MobileoverridesinGameSession.rendering/scaling_3d/mode=0
rendering/scaling_3d/scale=3.0
